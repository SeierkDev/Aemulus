# Aemulus — environment

# Required: Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: Turso / libsql. Leave unset to use a local SQLite file (./.data/aemulus.db).
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Auth: secret for signing session JWTs (set a long random string in prod)
AUTH_SECRET=

# Solana / $AEMU token gating
# Leave AEMULUS_MINT empty until launch — gating stays OFF (app open to any
# signed-in wallet). Paste the pump.fun token mint here to activate gating.
AEMULUS_MINT=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
# Access threshold + higher-tier cutoffs (tune at launch)
AEMULUS_MIN_BALANCE=1
AEMULUS_PRO_BALANCE=1000000
AEMULUS_WHALE_BALANCE=10000000
# Buy link shown on the gated screen
AEMULUS_PUMP_URL=https://pump.fun

# Creator economy: $AEMU credited to a skill's creator per external run
AEMULUS_RUN_FEE=10
# Autonomous scheduler tick interval (ms); default 60000
AEMULUS_SCHEDULER_MS=60000
