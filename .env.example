# Aemulus — environment

# Required: Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: Turso / libsql. Leave unset to use a local SQLite file (./.data/aemulus.db).
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Auth: secret for signing session JWTs (set a long random string in prod)
AUTH_SECRET=

# Solana / $AEMU token gating
# Leave AEMULUS_MINT empty until launch — gating stays OFF (app open to any
# signed-in wallet). Paste the pump.fun token mint here to activate gating.
AEMULUS_MINT=
# LAUNCH SAFETY: set to 1 once you go live so the app REFUSES to boot with gating
# off (a missing AEMULUS_MINT then fails fast instead of silently opening access to
# everyone). Leave unset/0 pre-launch. With it unset, boot only WARNS when gating
# is off. The boot log prints the live config line ("gating=… anchor[…] payouts=…").
# AEMULUS_REQUIRE_GATING=1
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
# Access threshold + higher-tier cutoffs (tune at launch)
AEMULUS_MIN_BALANCE=1
AEMULUS_PRO_BALANCE=1000000
AEMULUS_WHALE_BALANCE=10000000
# Per-tier DAILY run quotas (-1 = unlimited). These back the limits shown in the
# litepaper. Holder = level 1, Pro = level 2, Whale = level 3.
AEMULUS_QUOTA_HOLDER=5
AEMULUS_QUOTA_PRO=50
AEMULUS_QUOTA_WHALE=-1
# Buy link + social links shown in the UI (leave social unset to hide them)
AEMULUS_PUMP_URL=https://pump.fun
# AEMULUS_X_URL=https://x.com/your_handle
# AEMULUS_GITHUB_URL=https://github.com/your_org/aemulus
# SIWS domain bound into the sign-in message (defaults to the request host)
# AEMULUS_DOMAIN=aemulus.app

# Creator economy: $AEMU credited to a skill's creator per external run
AEMULUS_RUN_FEE=10
# On-chain creator payouts: set a base58 treasury signer to enable claims
# (sends accrued $AEMU from this wallet). Inactive until set + AEMULUS_MINT live.
AEMULUS_TREASURY_SECRET=
AEMULUS_DECIMALS=6
# Autonomous scheduler tick interval (ms); default 60000
AEMULUS_SCHEDULER_MS=60000

# Per-wallet rate limits (in-memory; tune for abuse control)
AEMULUS_GENERALIZE_PER_HOUR=20
# AEMULUS_SYNTHESIZE_PER_HOUR=20   # defaults to AEMULUS_GENERALIZE_PER_HOUR
AEMULUS_RUNS_PER_MIN=10
AEMULUS_RECORD_PER_HOUR=30
AEMULUS_RATE_PER_MIN=10
# Bulk runs: max rows per request + bulk requests per hour
AEMULUS_BULK_MAX=100
AEMULUS_BULK_PER_HOUR=10
# Max concurrent browser runs (run-slot semaphore); default = cpu-based
# AEMULUS_MAX_CONCURRENT_RUNS=

# Cost-display overrides: operator-model price (USD per 1M tokens)
# AEMULUS_OPERATOR_IN_PER_M=3
# AEMULUS_OPERATOR_OUT_PER_M=15

# Moderation: distinct reports to auto-takedown a skill; comma-separated wallets
# shown as "Verified" creators
AEMULUS_REPORT_TAKEDOWN=3
# AEMULUS_VERIFIED=wallet1,wallet2

# Content safety: run inputs (search queries, field values) and published skill
# names/descriptions are always checked against a built-in blocklist for hate
# speech + illegal content (ordinary profanity is allowed). Set to 1 to ALSO run
# an AI (Claude) check that catches contextual/obfuscated cases the blocklist
# can't — costs one small model call per run/publish, so it's opt-in.
AEMULUS_AI_MODERATION=0
# Minimum meaningful (non-navigation) steps a recording needs before it can be
# turned into a skill — blocks abandoned/blocked captures. Default 3.
AEMULUS_MIN_RECORDING_STEPS=3

# On-chain run receipts: set a base58 signer secret to anchor each run's hash
# on Solana (Memo). Leave empty to record the hash only ("anchors at launch").
AEMULUS_RECEIPT_SECRET=
AEMULUS_RECEIPT_CLUSTER=devnet
# AEMULUS_RECEIPT_RPC=   # defaults to the cluster's public RPC
# Merkle batcher interval (ms): receipts are anchored as one root per batch
AEMULUS_BATCH_MS=30000
# Anchor reconciler: recovers signatures for anchors that landed but whose confirm
# timed out (re-anchors sig-null batches, re-attempts registry/zk, and safely
# settles/rolls-back pending claims by matching the on-chain payout memo). Fully
# inert until an anchor path above is configured. Tick interval / per-tick cap /
# how far back to look.
# AEMULUS_RECONCILE_MS=300000
# AEMULUS_RECONCILE_MAX=50
# AEMULUS_RECONCILE_WINDOW_MS=86400000
# Claim reconciliation always SETTLES a payout it finds on-chain (safe). Rolling a
# claim BACK (un-claiming so the creator can retry) is done only when the payout is
# confirmed ABSENT — but that relies on the RPC reliably surfacing payout memos, and
# a miss would DOUBLE-PAY. So auto-rollback is OPT-IN: unset = confirmed-absent claims
# are logged for manual verification; =1 = auto-roll-back. Only enable after
# confirming your RPC surfaces memos AND no pending claim predates memo support.
# AEMULUS_CLAIM_AUTO_ROLLBACK=1
# NOTE: keep AEMULUS_RECEIPT_CLUSTER consistent across the Memo, registry, and zk
# anchors (they all read it) so one run's receipts don't split across chains.

# On-chain registry program (anchor/aemulus-registry): records each completed
# run's receipt as immutable on-chain state. Inert unless BOTH are set. Deploy
# the program (see anchor/README.md), then paste its program id + a base58 payer
# secret here. NOTE: this is one tx + rent per run (opt-in premium anchoring),
# separate from the cheap Memo batch above.
# AEMULUS_REGISTRY_PROGRAM=
# AEMULUS_REGISTRY_SECRET=

# ZK-compressed run receipts (anchor-zk/aemulus-zk-receipts, Light Protocol):
# records each completed run's receipt as a *compressed* account — ~100x cheaper
# than the registry above (~0.000015 vs ~0.0016 SOL) with an on-chain ZK validity
# proof. Inert unless ALL THREE are set AND the program IDL exists (built via
# `anchor build` in anchor-zk/; see anchor-zk/README.md). Needs a ZK-compression
# RPC (Helius/Photon) that serves the compression indexer + prover.
# AEMULUS_ZK_PROGRAM=
# AEMULUS_ZK_SECRET=
# AEMULUS_ZK_RPC=https://devnet.helius-rpc.com?api-key=YOUR_KEY
# AEMULUS_ZK_IDL=anchor-zk/target/idl/aemulus_zk_receipts.json

# Stealth mode: route run + record browser launches through playwright-extra +
# the stealth plugin, which masks the automation "tells" (navigator.webdriver,
# missing plugins, HeadlessChrome UA, absent window.chrome) that bot-detection
# walls (Cloudflare, DataDome, PerimeterX) fingerprint and block. ON by default;
# set to 0 to fall back to plain Playwright. Also makes a captcha solvable by a
# human — without it the session is pre-flagged and the challenge loops forever.
AEMULUS_STEALTH=1

# When a run hits a captcha/bot-wall, it opens the live view so a human can solve
# it, then resumes. This caps how many times it will pause before parking the run
# in needs_review (so it never loops "try again" endlessly). Default 3.
AEMULUS_CAPTCHA_MAX_PAUSES=3

# Outbound proxy for every run + recording. Datacenter/cloud IPs (Railway, etc.)
# get flagged by Google/Amazon ("unusual traffic from your network") no matter
# how good the stealth is — routing through a RESIDENTIAL or mobile proxy is the
# real fix. Sign up with a provider (Bright Data, Smartproxy, Oxylabs, IPRoyal…)
# and paste the gateway here. Leave unset to go direct (default).
# AEMULUS_PROXY_SERVER=http://gate.provider.com:7777
# AEMULUS_PROXY_USERNAME=your-proxy-user
# AEMULUS_PROXY_PASSWORD=your-proxy-pass

# Rich replay: capture rrweb DOM-mutation events during runs so the run page can
# replay the actual DOM pixel-for-pixel (scrub/play), far richer than the
# per-step screenshot scrubber. Off by default and inert otherwise; capture is
# best-effort and never affects a run's outcome. Resources are inlined so the
# replay is self-contained. Adds some per-run overhead + storage (events are
# gzipped under .data/recordings/<wallet>/<run>/rrweb.json.gz).
AEMULUS_RRWEB=0

# QuickBooks Online (invoice write path). Inert unless all three are set; the
# connect flow returns 503 until then. Register the app at developer.intuit.com,
# add the redirect URI, and paste the Development (sandbox) keys here.
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=http://localhost:3000/api/qbo/callback
# QBO_ENV=sandbox                 # 'sandbox' (default) or 'production'
# QBO_BASE=                       # optional API base override (tests/self-host)
# QBO_TOKEN_URL=                  # optional token endpoint override (tests)

# AP invoice-entry cap for the Holder tier, per 30 days. Pro/Whale tiers (and any
# wallet when token gating is off) are unlimited. Access + tiers are governed by
# $AEMU balance — see AEMULUS_MINT and the tier cutoffs above.
AEMULUS_FREE_ENTRY_LIMIT=10

# AP workspace activity generator. When 1, runs a realistic invoice through the
# real pipeline on an interval (clean ones auto-entered + sealed, flagged ones
# sent to the review queue) so the Activity feed stays live. Every record is a
# genuine, verifiable sealed entry; inputs are seeded. Off by default.
AEMULUS_AP_ACTIVITY=0
AEMULUS_AP_ACTIVITY_MS=60000

# Marketplace run-activity generator (pre-launch). When 1, adds 5–15 completed
# runs per day — by anonymous external users (fresh random pubkeys, never your
# wallets) — against the published skills, so a fresh deployment keeps showing
# recent activity. Bumps each skill's run count; seeds NO earnings (creator
# earnings accrue only from real usage). Never touches the interactive run
# pipeline. Off by default. Requires the marketplace seed
# (scripts/seed-marketplace.mjs).
AEMULUS_ACTIVITY_RUNS=0
AEMULUS_ACTIVITY_RUNS_MS=3600000

# Ops / observability: /api/health returns a minimal public body (ok/db/uptime).
# Set a secret here to also expose the detailed telemetry (metrics, queue depth,
# gating flag, and the full live launch config) — request it with the
# `x-metrics-token` header. Unset = detailed body never exposed.
# AEMULUS_METRICS_TOKEN=

# Run sandbox guardrails: hard wall-clock cap + per-action cap (ms)
AEMULUS_RUN_TIMEOUT_MS=120000
AEMULUS_STEP_TIMEOUT_MS=20000

# Agentic fallback (opt-in, experimental): when a step can't be located, let the
# model drive the browser to finish it (bounded). Off unless set to 1.
AEMULUS_AGENT_FALLBACK=0
AEMULUS_AGENT_MAX_STEPS=5
# Live human takeover at interactive checkpoints (e.g. 2FA). Off unless 1.
AEMULUS_LIVE_HANDOFF=0
AEMULUS_LIVE_TIMEOUT_MS=300000
# Max elements captured per in-skill extract loop
AEMULUS_LOOP_MAX=500
