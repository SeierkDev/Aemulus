# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database (libsql file fallback)
/.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Rust/Anchor build artifacts
/anchor/target/
/anchor-zk/target/

# Local sandbox credentials for the QBO smoke tool (never committed)
/scripts/qbo/.env.local
