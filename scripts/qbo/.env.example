# Batch-1 QBO sandbox smoke test — local credentials.
# Copy this file to .env.local (gitignored) and fill in the two values.
#
#   cp scripts/qbo/.env.example scripts/qbo/.env.local
#
# Get both from your Intuit developer account (sandbox):
#   QBO_REALM  = your sandbox company's realmId
#   QBO_TOKEN  = a sandbox access token from the OAuth 2.0 Playground (expires ~1h)

QBO_REALM=
QBO_TOKEN=

# Optional: set to a non-existent name to exercise the unknown-vendor branch.
# QBO_VENDOR_NAME=Nope Corp
