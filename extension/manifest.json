{
  "manifest_version": 3,
  "name": "Aemulus Recorder",
  "version": "0.1.0",
  "description": "Record a task in your own browser and turn it into a reusable Aemulus skill — no login re-do, no bot walls.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Aemulus Recorder" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
